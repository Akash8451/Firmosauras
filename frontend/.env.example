# Firmosaurus frontend — copy to `.env.local` and adjust if your ports differ.
# The frontend runs natively on the host, so these point at the host-facing
# listeners the compose stack exposes.

# Upload Gateway + CVE HTTP surface (FastAPI).
VITE_GATEWAY_URL=http://localhost:8000

# WebSocket notifier (separate process, own consumer group).
VITE_NOTIFIER_WS_URL=ws://localhost:8001
