# ============================================================================
# Firmosaurus — environment template. Copy to `.env` and fill in secrets.
# `.env` is gitignored; this file ships key NAMES only, never real secrets.
# ============================================================================

# ---- Router topology (see backend-architecture.md rule 5) ------------------
# Local dev fat container: one process hosts every handler.
# Valid: triage | unpack | analysis | match | aggregate | all (comma-combos ok)
SERVICES=all

# ---- LLM (OPTIONAL external enhancement — NOT part of the air-gapped core) -
# OpenAI-compatible client; swapping provider is config-only. Default = Groq.
# Failover documented in schema.md §8: gemini-2.5-flash-lite via its OpenAI-compat URL.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# ---- Embedding model (LOCKED — schema.md §6) -------------------------------
# Change model and EMBEDDING_DIM together; pgvector fixes vector(384) at table creation.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Redpanda (Kafka API) --------------------------------------------------
# Host-facing listener for natively-run scripts/frontend; internal for the router container.
# Use the IPv4 literal on Windows: `localhost` resolves to ::1 first and librdkafka
# fails to reach the mapped IPv4 port.
REDPANDA_BROKERS=127.0.0.1:19092
REDPANDA_BROKERS_INTERNAL=redpanda:9092

# ---- Postgres (+ pgvector) -------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=firmosaurus
POSTGRES_USER=firmosaurus
POSTGRES_PASSWORD=change-me-in-env
# Convenience DSN (internal router uses host `postgres`).
POSTGRES_DSN=postgresql://firmosaurus:change-me-in-env@localhost:5432/firmosaurus

# ---- Redis (single instance, noeviction — structural state only) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- MinIO (S3-compatible) -------------------------------------------------
# Presign client uses the localhost endpoint (frontend runs natively on host);
# internal-ops client uses the minio:9000 endpoint. MINIO_SERVER_URL must be
# localhost:9000 so presigned URLs resolve from the host (hard-constraints §3).
MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT_INTERNAL=minio:9000
MINIO_SERVER_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-env
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=raw-uploads

# ---- MongoDB (reports; wiredTigerCacheSizeGB capped in compose) ------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=firmosaurus
MONGO_URL=mongodb://localhost:27017/firmosaurus

# ---- Auth (inlined HS256 JWT, RBAC roles admin/analyst/reader — schema.md §5)
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
